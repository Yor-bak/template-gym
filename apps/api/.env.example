# Copia este archivo como .env y llena los valores. Nunca subas .env a git.

# postgresql+asyncpg://usuario:password@host:puerto/basededatos
DATABASE_URL=postgresql+asyncpg://gym:changeme@localhost:5432/gym

# Genera uno largo y aleatorio, por ejemplo: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme
JWT_EXPIRY_MIN=1440

# Secreto separado para firmar el QR de acceso (member/trainer) — nunca el
# mismo que JWT_SECRET, se rota independientemente de las sesiones activas.
QR_SECRET=changeme-too

# Orígenes permitidos para CORS, separados por coma (sin espacios).
# En dev local del dashboard/app suele ser http://localhost:3000,http://localhost:8081
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

ENV=development

# Integración interna con admin-panel-j2ec (aprovisionamiento de gimnasios,
# Decisión #10 de ese proyecto). ADMIN_PANEL_SERVICE_KEY es un secreto
# COMPARTIDO entre ambos backends — coordinar el valor real con el equipo de
# admin-panel-j2ec, nunca inventarlo de este lado. Vacío por defecto: la
# integración falla explícitamente si se usa sin configurar, pero no bloquea
# el resto del backend si no se toca.
ADMIN_PANEL_BASE_URL=https://api-admin.j2ec-nodes.com
ADMIN_PANEL_SERVICE_KEY=
