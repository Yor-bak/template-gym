# Producción (forge02) — copiar como .env junto a docker-compose.prod.yml.
# Nunca subir el .env real a git. Nunca reutilizar credenciales de
# admin-panel-j2ec-backend en este archivo (excepto ADMIN_PANEL_SERVICE_KEY,
# ver nota abajo).

# Postgres — credenciales nuevas y propias de este servicio.
# Generar con: openssl rand -base64 24
POSTGRES_USER=gym_prod
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gym_prod

DATABASE_URL=postgresql+asyncpg://gym_prod:changeme@postgres:5432/gym_prod

# JWT_SECRET propio de este servicio — nunca el mismo que admin-panel-j2ec.
# Generar con: openssl rand -hex 32
JWT_SECRET=changeme
JWT_EXPIRY_MIN=1440

# Secreto de firma del QR de acceso — distinto de JWT_SECRET.
# Generar con: openssl rand -hex 32
QR_SECRET=changeme-too

# TODO: activar gym.j2ec-nodes.com aquí cuando el frontend de gym se
# despliegue (dominio ya decidido, 2026-07-17 — solo falta el deploy).
# Mientras tanto, dejar solo lo necesario para pruebas internas.
CORS_ORIGINS=http://localhost:3000

ENV=production

# Integración interna con admin-panel-j2ec — este valor debe ser IDÉNTICO al
# INTERNAL_SERVICE_KEY del .env de admin-panel-j2ec-backend en este mismo
# servidor. Copiarlo directamente entre los dos .env en forge02, nunca por
# este chat.
ADMIN_PANEL_BASE_URL=https://api-admin.j2ec-nodes.com
ADMIN_PANEL_SERVICE_KEY=
