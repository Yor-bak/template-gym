FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini ./
COPY scripts ./scripts

RUN pip install --no-cache-dir .

EXPOSE 8000

# Cada despliegue aplica únicamente las migraciones pendientes antes de
# aceptar tráfico. Alembic usa DDL transaccional en Postgres: si una
# migración falla, gunicorn no arranca y el fallo queda visible en el estado
# y los logs del contenedor.
CMD ["sh", "-c", "alembic upgrade head && exec gunicorn app.main:app -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:8000 --workers 2"]
