# Producción (forge02) — copiar como .env junto a docker-compose.prod.yml
# (apps/web/.env). Se usa como build arg: Next.js incrusta NEXT_PUBLIC_*
# en el bundle del cliente en build time, así que cambiar este archivo
# requiere reconstruir la imagen (docker compose build), no solo reiniciar
# el contenedor.

NEXT_PUBLIC_API_URL=https://api-gym.j2ec-nodes.com
