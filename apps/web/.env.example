# Copia este archivo como .env.local y llena con los valores de infra/.env
# (o del proyecto de Supabase Cloud, si usan esa opción).

# Backend real (apps/api). Si esta variable está definida, el store y el auth
# hablan con apps/api en vez de Supabase o el modo demo — ver isApiMode() en
# lib/data/config.ts. Deja vacío/sin definir para usar Supabase o demo.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Expuestas al navegador (deben empezar con NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=http://192.168.0.15:8010
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SOLO servidor — nunca poner el prefijo NEXT_PUBLIC_ en esta, o quedaría
# expuesta en el navegador. Se usa en Route Handlers para crear cuentas de
# staff/entrenador vía la Admin API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
