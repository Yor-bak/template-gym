# Copia este archivo como .env y genera los secretos con:
#   node scripts/generate-secrets.js
# (te imprime los valores listos para pegar aquí, o usa --write para que
# los escriba directo en .env)
#
# NUNCA subas el archivo .env real a git (ya está en .gitignore).

############
# Postgres
############
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Carpeta donde vive la data de Postgres/Storage (bind mount).
# Para migrar a un SSD por USB más adelante: monta el SSD, copia esta
# carpeta ahí, y cambia esta ruta para que apunte al nuevo mount point.
GYM_DATA_PATH=./data

############
# JWT / API keys
# Generar con: node scripts/generate-secrets.js
############
JWT_SECRET=changeme-32-characters-minimum
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=

# Dejar vacíos (modo legacy HS256, ver kong-entrypoint.sh)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

############
# Dashboard (Supabase Studio) — solo accesible localmente, ver docker-compose.yml
############
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme

PG_META_CRYPTO_KEY=changeme-32-characters-minimum

############
# URLs — cambiar por su dominio real una vez configurado el túnel
############
# URL pública por la que la app móvil y el dashboard web hablarán con el backend
SUPABASE_PUBLIC_URL=https://api.tu-dominio.com
API_EXTERNAL_URL=https://api.tu-dominio.com
SITE_URL=https://tu-dominio.com
ADDITIONAL_REDIRECT_URLS=

############
# Kong (API gateway) — puerto expuesto al túnel público
############
KONG_HTTP_PORT=8000

############
# Auth
############
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

# SMTP real necesario para que ENABLE_EMAIL_AUTOCONFIRM=false funcione
# (confirmación de correo). Mientras no tengan SMTP, dejen
# ENABLE_EMAIL_AUTOCONFIRM=true para poder probar sin enviar correos reales.
SMTP_ADMIN_EMAIL=admin@tu-dominio.com
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=GYM

############
# PostgREST
############
PGRST_DB_SCHEMAS=public,storage
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# Studio
############
STUDIO_DEFAULT_ORGANIZATION=Template GYM
STUDIO_DEFAULT_PROJECT=Template GYM

############
# Storage
############
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
S3_PROTOCOL_ACCESS_KEY_ID=stub
S3_PROTOCOL_ACCESS_KEY_SECRET=stub
