# Copia este archivo como .env y genera los secretos con:
#   node scripts/generate-secrets.js --write
#
# NUNCA subas el archivo .env real a git (ya está en .gitignore).

############
# Postgres
############
POSTGRES_DB=gym
POSTGRES_USER=gym
POSTGRES_PASSWORD=changeme

# Carpeta donde vive la data de Postgres (bind mount).
# Para migrar a un SSD por USB más adelante: monta el SSD, copia esta
# carpeta ahí, y cambia esta ruta para que apunte al nuevo mount point.
GYM_DATA_PATH=./data

############
# API (FastAPI)
############
JWT_SECRET=changeme-32-characters-minimum
JWT_EXPIRY_MIN=1440

# Puerto público de la API (el que se expone al túnel/dominio).
API_PORT=8000

# Orígenes permitidos para CORS, separados por coma (sin espacios) — los
# dominios reales del dashboard/túnel cuando estén listos.
CORS_ORIGINS=http://localhost:3000
